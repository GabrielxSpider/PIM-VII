@{
    ViewData["Title"] = "Novo conteúdo";
}

<div class="conteudo-form-page">

    <div class="page-header">
        <div>
            <h2>Novo conteúdo</h2>
            <p>Cadastre um novo conteúdo de diversidade na plataforma.</p>
        </div>
    </div>

    <div class="conteudo-form-card">

        <form method="post"
              action="/ConteudosDiversidadeMvc/Criar">

            <div class="form-group">
                <label for="Titulo">Título</label>

                <input type="text"
                       id="Titulo"
                       name="Titulo"
                       maxlength="150"
                       placeholder="Digite o título do conteúdo"
                       required />
            </div>

            <div class="form-group">
                <label for="Descricao">Descrição</label>

                <textarea id="Descricao"
                          name="Descricao"
                          maxlength="500"
                          rows="4"
                          placeholder="Digite uma breve descrição"
                          required></textarea>
            </div>

            <div class="form-group">
                <label for="Tipo">Tipo</label>

                <select id="Tipo"
                        name="Tipo"
                        required>

                    <option value="">Selecione o tipo</option>

                    <option value="1">
                        Artigo
                    </option>

                    <option value="2">
                        Vídeo
                    </option>

                    <option value="3">
                        Treinamento Corporativo
                    </option>

                </select>
            </div>

            <div class="form-group">
                <label for="Conteudo">Conteúdo</label>

                <textarea id="Conteudo"
                          name="Conteudo"
                          rows="10"
                          placeholder="Digite o conteúdo completo"
                          required></textarea>
            </div>

            @if (ViewBag.Erro != null)
            {
                <div class="form-error">
                    @ViewBag.Erro
                </div>
            }

            <div class="form-actions">

                <a href="/ConteudosDiversidadeMvc"
                   class="btn-secondary">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn-primary">
                    Salvar conteúdo
                </button>

            </div>

        </form>

    </div>

</div>