@model BackendPIM.Services.ServicoDto

@{
    ViewData["Title"] = "Editar serviço";
}

<div class="services-page">

    <div class="page-header">
        <div>
            <h2>Editar serviço</h2>
            <p>Atualize as informações do serviço cadastrado.</p>
        </div>

        <a href="/ServicosMvc" class="btn-secondary">
            ← Voltar
        </a>
    </div>

    <div class="form-card">

        <div class="form-card-header">
            <h3>Informações do serviço</h3>
            <span>Altere os dados abaixo</span>
        </div>

        <form method="post" action="/ServicosMvc/Editar" class="service-form">

            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="form-group">
                <label for="titulo">Título do serviço</label>

                <input
                    type="text"
                    id="titulo"
                    name="Titulo"
                    value="@Model.Titulo"
                    required />
            </div>

            <div class="form-group">
                <label for="descricao">Descrição</label>

                <textarea
                    id="descricao"
                    name="Descricao"
                    rows="5"
                    required>@Model.Descricao</textarea>
            </div>

            <div class="form-group">
                <label for="preco">Preço base</label>

                <div class="price-input">
                    <span>R$</span>

                    <input
                        type="number"
                        id="preco"
                        name="PrecoBase"
                        value="@Model.PrecoBase"
                        step="0.01"
                        min="0"
                        required />
                </div>
            </div>

            <div class="form-actions">

                <a href="/ServicosMvc" class="btn-secondary">
                    Cancelar
                </a>

                <button type="submit" class="btn-primary">
                    Salvar alterações
                </button>

            </div>

        </form>

    </div>

</div>