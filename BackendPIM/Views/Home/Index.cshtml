@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard">

    <div class="welcome">
        <h2>Bem-vindo ao ConectaLar</h2>

        <p>
            Aqui você poderá acompanhar e administrar
            as principais informações da plataforma.
        </p>
    </div>

    <div class="dashboard-stats">

        <div class="dashboard-card">
            <span class="dashboard-card-title">
                Serviços cadastrados
            </span>

            <strong class="dashboard-card-value">
                @ViewBag.TotalServicos
            </strong>
        </div>

        <div class="dashboard-card">
            <span class="dashboard-card-title">
                Profissionais cadastrados
            </span>

            <strong class="dashboard-card-value">
                @ViewBag.TotalProfissionais
            </strong>
        </div>

        <div class="dashboard-card">
            <span class="dashboard-card-title">
                Agendamentos
            </span>

            <strong class="dashboard-card-value">
                @ViewBag.TotalAgendamentos
            </strong>
        </div>

        <div class="dashboard-card">
            <span class="dashboard-card-title">
                Relatos
            </span>

            <strong class="dashboard-card-value">
                @ViewBag.TotalRelatos
            </strong>
        </div>

        <div class="dashboard-card">
            <span class="dashboard-card-title">
                Conteúdos
            </span>

            <strong class="dashboard-card-value">
                @ViewBag.TotalConteudos
            </strong>
        </div>

    </div>

</div>